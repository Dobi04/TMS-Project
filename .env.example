MYSQL_ROOT_PASSWORD=change-this-local-password
MYSQL_DATABASE=excursion_db
ROOT_PASS=change-this-local-password
REPL_USER=repl
REPL_PASS=change-this-replication-password

# Backend configuration (provide these through the process environment or user secrets)
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=excursion_db;User=app;Password=change-this-app-password;
Jwt__Key=replace-with-a-random-secret-at-least-32-characters-long
Jwt__Issuer=ExcursionSaaS
Jwt__Audience=ExcursionSaaSKorisnici
Jwt__ExpiresInMinutes=60